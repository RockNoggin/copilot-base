# === Required ===
# GitHub personal access token with Copilot scope.
# Generate at: https://github.com/settings/tokens
# NEVER commit a real token — use environment variables on the host.
GH_TOKEN=

# === Optional ===
# Alternative token variable. Copilot CLI will use either GH_TOKEN or GITHUB_TOKEN.
# GITHUB_TOKEN=

# Workspace path on the host to mount into the container
# WORKSPACE_PATH=D:\MyProject

# Container name override (default: copilot-<workspace-dirname>)
# CONTAINER_NAME=copilot-myproject
